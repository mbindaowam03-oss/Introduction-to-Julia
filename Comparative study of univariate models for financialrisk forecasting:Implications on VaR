        "%%R\n",
        "#compare VaR resultss\n",
        "#extraction of VaR-backtest results\n",
        "get_VaR_results = function(roll_object, model_name, alpha){\n",
        "\n",
        "  #results = as.data.frame(roll_object, which = \"VaR\", VaR.alpha = alpha)\n",
        "  results = as.data.frame(roll_object, which = \"VaR\")\n",
        "  if(alpha==0.05){\n",
        "    VaR=results$'alpha(5%)'}\n",
        "  else{VaR=results$'alpha(1%)'}\n",
        "\n",
        "  actual = results$realized\n",
        "  valid = !is.na(actual)&!is.na(VaR)\n",
        "  actual = actual[valid]\n",
        "  VaR = VaR[valid]\n",
        "\n",
        "  violations = sum(actual<VaR)\n",
        "  n=length(actual)\n",
        "  expected = n*alpha\n",
        "  data.frame(Model= model_name, Confidence=paste0((1-alpha)*100,\"%\"),\n",
        "             Violations=violations, Expected=round(expected,2),\n",
        "             Exceedance_Rate=round(violations/n*100,2))\n",
        "}\n",
        "\n",
